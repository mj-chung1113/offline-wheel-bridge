# 이 파일을 bridge.env로 복사한 뒤 환경에 맞게 수정하세요.
# 암호와 개인키는 이 파일에 저장하지 않습니다.

# 인터넷에 연결되는 릴레이 서버(예: 172)의 Python입니다.
# 충주에서 사용할 Python과 major/minor 및 ABI가 같아야 합니다.
PYTHON_BIN=/opt/conda/envs/research/bin/python

# 릴레이 서버에 패키지를 누적할 위치입니다.
SOURCE_WHEELHOUSE=/srv/offline-wheel-bridge/wheelhouse

# Windows PC가 릴레이 서버에 만든 역방향 터널의 입구입니다.
TARGET_TUNNEL_HOST=127.0.0.1
TARGET_TUNNEL_PORT=44000

# 충주 계정과 모든 컨테이너가 공유하는 NFS wheelhouse입니다.
TARGET_SSH_USER=cluster_user
TARGET_WHEELHOUSE=/shared/offline-wheel-bridge/wheelhouse

# 1이면 공식 binary wheel만 허용합니다. wheel이 없는 패키지는 실패합니다.
# 0이면 source distribution도 내려받지만 충주에서 빌드 도구가 필요할 수 있습니다.
BINARY_ONLY=0

# 전체 conda 환경 패킹 설정입니다.
SOURCE_ENV_PREFIX=/opt/conda/envs/research
CONDA_PACK_BIN=/opt/conda/bin/conda-pack
SOURCE_ENV_ARCHIVE_DIR=/srv/offline-wheel-bridge/env-archives
ENV_ARCHIVE_NAME=research-env.tar.gz
TARGET_ENV_ARCHIVE_DIR=/shared/offline-wheel-bridge/env-archives

# conda가 관리하던 파일을 pip가 덮어쓴 불완전한 환경에서만 1로 설정합니다.
# 정상 환경에서는 반드시 0을 유지하세요.
PACK_IGNORE_MISSING=0
