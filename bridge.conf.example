# bridge.conf로 복사한 뒤 [필수 수정] 값만 먼저 바꾸세요.
# 이 파일에는 암호, 개인키, API 토큰을 기록하지 않습니다.

# ── Windows -> relay -> container 터널 ────────────────────────────────
RELAY_USER="[필수 수정: relay 서버 사용자명]"
RELAY_HOST="[필수 수정: relay 서버 IP 또는 도메인]"
CLUSTER_HOST="[필수 수정: Windows에서 접속하는 클러스터 IP 또는 도메인]"
CLUSTER_PORT="[필수 수정: 대상 컨테이너 SSH 포트]"

# [선택] 같은 relay에서 다른 사용자와 겹치지 않는 포트를 고릅니다.
# TUNNEL_HOST는 특별한 이유가 없으면 수정하지 않습니다.
TUNNEL_HOST="127.0.0.1"
TUNNEL_PORT="44013"

# ── relay에서 실행하는 환경 배포 ─────────────────────────────────────
REMOTE_USER="[필수 수정: 컨테이너 SSH 사용자명]"

# [필수 수정] relay에 설치된 conda 루트와 conda-pack 실행파일입니다.
SOURCE_CONDA_ROOT="[필수 수정: relay conda 루트 절대경로]"
CONDA_PACK_BIN="[필수 수정: relay conda-pack 실행파일 절대경로]"

# [선택] relay의 환경 압축본 보관 위치입니다. 기본값은 수정 불필요합니다.
LOCAL_ARCHIVE_DIR="/home/$RELAY_USER/conda-env-archives"

# [수정 불필요] 표준 Conda 구조입니다. 실제 환경은 envs 아래에 설치됩니다.
REMOTE_CONDA_ROOT="/home/$REMOTE_USER/anaconda"
REMOTE_ARCHIVE_DIR="$REMOTE_CONDA_ROOT/env-archives"

# [선택] 배포 후 import를 검사할 모듈을 쉼표로 나열합니다. 비우면 생략합니다.
SMOKE_IMPORTS="torch"
